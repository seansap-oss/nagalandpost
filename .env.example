# Add these in Vercel Project Settings > Environment Variables (Production, Preview)
# Never commit .env files with real secrets.
ADMIN_PASSWORD=replace-with-strong-password
ANALYTICS_SALT=replace-with-long-random-secret
UPSTASH_REDIS_REST_URL=https://your-upstash-db.upstash.io
UPSTASH_REDIS_REST_TOKEN=replace-with-your-upstash-token
